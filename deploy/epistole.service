[Unit]
Description=epistole — sovereign newsletter service
After=network.target
# Pin to the boot's real network online state. /healthz responds to
# Caddy / NPM faster if we don't restart while the network is still
# coming up.
Wants=network-online.target

[Service]
Type=simple
User=epistole
Group=epistole
WorkingDirectory=/var/lib/epistole
ExecStart=/usr/local/bin/epistole --config /etc/epistole/epistole.toml
# Secrets live in /etc/epistole.env (0600 root); the toml references
# them via ${VAR} placeholders. Resolved at startup (see config.rs's
# resolve_secret_env). Phase 0 deploys can comment this out and inline
# secrets in the toml — Phase 1 hardening makes this the default.
EnvironmentFile=/etc/epistole.env
Restart=always
RestartSec=5

# === Hardening (sandbox) ===
# Each successive directive narrows the privilege envelope; only items
# strictly needed for outbound HTTPS to the SMTP relay + reading config
# + writing /var/lib/epistole/data are kept.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# AF_INET + AF_INET6 for HTTP server + outbound SMTP; AF_UNIX for the
# tracing-subscriber's journal forwarding. Nothing else (no AF_NETLINK,
# no AF_PACKET, no raw sockets).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Drop every capability except what an unprivileged HTTP service needs
# — i.e., none. Bind to a low port is not in scope (epistole listens on
# 9091; NPM does the :443 termination).
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem writes scoped to the data dir.
ReadWritePaths=/var/lib/epistole

# Syscall allowlist — system-service is systemd's curated set for
# typical network daemons; @privileged + @resources adders are explicitly
# denied to block CAP_SYS_ADMIN-class system calls even if a future code
# path tries them.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @cpu-emulation @debug @keyring @module @obsolete @raw-io @reboot @swap

# Resource limits. MemoryMax= is deliberately absent: basanos'
# OPERATIONS/no-memory-max-on-service-unit bans it fleet-wide because on
# forge/archeion hosts it shares a cgroup hierarchy with CI build jobs
# and can deadlock them (AP.7). That rationale doesn't apply to this
# host (a dedicated deploy target, not a CI runner), but the check is
# unconditional for any non-ergates/-ci-runner *.service file, so the
# hard ceiling is dropped rather than exempted. MemoryHigh= still
# throttles the cgroup under memory pressure; the kernel OOM killer is
# the backstop if that's not enough.
MemoryHigh=512M
TasksMax=128
LimitNOFILE=4096

# Files this service creates (the fjall keyspace) should not be world-
# readable by default. 0077 means user-only; group adds nothing the
# epistole runtime user needs.
UMask=0077

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
