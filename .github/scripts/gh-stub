#!/usr/bin/env bash
# WHY: stubs `gh` for testing the dependabot-auto-merge CI-check guard
# without a live PR. Handles only the two `gh pr checks` shapes the guard
# calls; anything else fails loudly rather than returning a misleading
# default.
#
# CHECKS_JSON (env, required): the `--json name,bucket` payload to return.
set -euo pipefail

: "${CHECKS_JSON:?CHECKS_JSON must be set}"

if [[ "${1:-}" == "pr" && "${2:-}" == "checks" ]]; then
  shift 2
  for arg in "$@"; do
    if [[ "$arg" == "--required" ]]; then
      # WHY: the first call in the guard is --watch --interval 30
      # --required; the fixture only exercises the second call's bucket
      # interpretation, so required-check waiting always succeeds here.
      exit 0
    fi
  done
  echo "$CHECKS_JSON"
  exit 0
fi

echo "gh-stub: unhandled invocation: gh $*" >&2
exit 99
